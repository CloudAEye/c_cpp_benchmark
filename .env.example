# Copy this file to `.env` and fill in your own values. NEVER commit `.env`.
# All pipeline scripts read these from the environment (a local `.env` is
# auto-loaded from the directory you run the scripts in).

# --- GitHub (step0 fork creation + step1 comment scraping) ---
# A classic or fine-grained PAT. For step0 (creating forks in your org) it needs
# `repo` + `workflow` scope. For step1 (read-only scraping) `public_repo` is enough.
GITHUB_TOKEN=

# --- Judge LLM (step2 / step2_5 / step3) ---
# The judge is an OpenAI-compatible client. The published leaderboard uses
# Anthropic's claude-sonnet-4-5-20250929 reached through the OpenAI-compatible
# endpoint. To reproduce it exactly, point MARTIAN_* at Anthropic:
#
#   MARTIAN_API_KEY=sk-ant-...                      # your Anthropic API key
#   MARTIAN_BASE_URL=https://api.anthropic.com/v1/
#   MARTIAN_MODEL=claude-sonnet-4-5-20250929
#
# Any OpenAI-compatible endpoint works (OpenAI, Martian, a local gateway, etc.),
# but to compare against the published numbers you MUST use the same judge model.
MARTIAN_API_KEY=
MARTIAN_BASE_URL=https://api.anthropic.com/v1/
MARTIAN_MODEL=claude-sonnet-4-5-20250929
