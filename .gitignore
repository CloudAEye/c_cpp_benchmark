# Secrets — never commit
.env

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# Local exports
*.xlsx

# The published judge folders (results/*/evaluations.json) and the scrubbed raw
# scrape (results/benchmark_data.json) are committed so the pipeline reproduces
# and is inspectable out of the box. Per-judge extraction/dedup intermediates
# are not committed (regenerate by re-running step2/step2_5):
results/**/candidates.json
results/**/dedup_groups.json
